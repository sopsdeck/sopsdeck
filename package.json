{
  "name": "@sopsdeck/sopsdeck",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.2.21",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "sopsdeck": "./bin/sopsdeck.mjs",
    "sd": "./bin/sopsdeck.mjs"
  },
  "files": [
    "bin/sopsdeck.mjs",
    "desktop/src"
  ],
  "scripts": {
    "fmt": "./scripts/fmt",
    "lint": "./scripts/lint",
    "test": "./scripts/test",
    "cover": "./scripts/cover",
    "docs": "./scripts/docs",
