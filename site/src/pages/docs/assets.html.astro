---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { repoJson } from '../../lib/content.mjs';

const catalog = repoJson('docs/assets/catalog.json');
---

<SiteLayout
  title="Sopsdeck — assets"
  description="Sopsdeck product stills, clips, walkthrough, and CLI demos."
  active="docs"
  narrow
>
  <section class="hero hero--compact">
    <p class="kicker">Catalog</p>
    <h1>Product assets</h1>
    <p>
      Stills, clips, walkthrough, and CLI demos from <code>./scripts/demo</code> and <code
        >./scripts/cli-video.mjs</code
      >.
    </p>
  </section>
  <div class="prose">
    <p>
      Generated by <code>./scripts/docs</code> from <a href="/assets/catalog.json">catalog.json</a>.
      Stills, clips, and CLI demos come from the repository demo scripts. Do not screenshot by hand.
    </p>
    <h2>Walkthrough</h2>
    <p>
      Full studio path (open, edit, save, commit, Sync, grant Access, Publish): <a
        href={`/assets/${catalog.walkthrough}`}>{catalog.walkthrough}</a
      >
    </p>
    <h2>Stills and clips</h2>
    <table>
      <thead><tr><th>Action</th><th>Still</th><th>Clip</th></tr></thead>
      <tbody>
        {
          catalog.items.map((item) => (
            <tr>
              <td>{item.title}</td>
              <td>
                <a href={`/assets/${item.still}`}>{item.title}</a>
              </td>
              <td>
                <a href={`/assets/${item.clip}`}>{item.clip}</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    {
      catalog.cli?.length > 0 && (
        <>
          <h2>CLI demos</h2>
          <p>
            Recorded by <code>./scripts/demo</code> from real <code>sopsdeck</code> against copies
            from the real local <code>sopsdeck</code> binary. Castkit-rendered MP4s and Asciinema v2{' '}
            <code>.cast</code> files.
          </p>
          <table>
            <thead>
              <tr>
                <>
                  <th>Command</th>
                  <>
                    <th>Cast</th>
                    <th>Video</th>
                  </>
                </>
              </tr>
            </thead>
            <tbody>
              {catalog.cli.map((item) => (
                <tr>
                  <td>{item.title}</td>
                  <td>
                    <a href={`/assets/${item.cast}`}>{item.cast}</a>
                  </td>
                  <td>{item.video && <a href={`/assets/${item.video}`}>{item.video}</a>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )
    }
  </div>
</SiteLayout>
