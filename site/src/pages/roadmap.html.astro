---
import SiteLayout from '../layouts/SiteLayout.astro';
import { roadmapPhases } from '../lib/content.mjs';

const phases = roadmapPhases();
---

<SiteLayout
  title="Sopsdeck — roadmap"
  description="Sopsdeck delivery phases, current proof, and work still open."
  active="roadmap"
  narrow
>
  <section class="hero hero--compact">
    <p class="kicker">Roadmap</p>
    <h1>What ships next</h1>
    <p>
      Delivery phases stay close to the product seams they prove. This board is generated from the
      build plan.
    </p>
  </section>
  <div class="prose">
    <table class="roadmap">
      <thead>
        <tr><th>Phase</th><th>Slice</th><th>Status</th><th>Proved</th><th>Still open</th></tr>
      </thead>
      <tbody>
        {
          phases.map((phase) => (
            <tr>
              <td class="mono">{phase.phase}</td>
              <td>
                <strong>{phase.slice}</strong>
              </td>
              <td>
                <span class:list={['roadmap-status', phase.status.replaceAll(' ', '-')]}>
                  {' '}
                  {phase.status}{' '}
                </span>
              </td>
              <td>{phase.proved}</td>
              <td>{phase.open}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p>See the <a href="/docs/seams.html">public seams</a> for the tests behind each phase.</p>
  </div>
</SiteLayout>
