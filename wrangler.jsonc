{
  // Public site at sopsdeck.com. Build: bun run site:build. Deploy: bunx wrangler@4 deploy
  "name": "sopsdeck",
  "main": "./site/dist/server/entry.mjs",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "workers_dev": true,
  "routes": [{ "pattern": "sopsdeck.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./site/dist/client",
  },
  "observability": {
    "enabled": true,
  },
}
