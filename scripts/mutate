#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export PATH="$(go env GOPATH)/bin:${PATH}"

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing %s — %s\n' "$1" "$2" >&2
    exit 1
  fi
}

printf '== go mutants (gremlins) ==\n'
need gremlins "go install github.com/go-gremlins/gremlins/cmd/gremlins@latest"
gremlins unleash ./internal/cli
