#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export PATH="$(go env GOPATH)/bin:${PATH}"

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing %s — %s\n' "$1" "$2" >&2
    exit 1
  fi
}

need gofumpt "go install mvdan.cc/gofumpt@latest"
need golangci-lint "https://golangci-lint.run/welcome/install/"
need bun "https://bun.sh"
need cargo "https://rustup.rs"

printf '== gofumpt ==\n'
unformatted="$(gofumpt -extra -l cmd internal)"
if [ -n "$unformatted" ]; then
  printf '%s\n' "$unformatted" >&2
  printf 'gofumpt: files are not formatted; run ./scripts/fmt\n' >&2
  exit 1
fi

printf '== golangci-lint ==\n'
golangci-lint run ./cmd/... ./internal/...

printf '== rustfmt ==\n'
(cd desktop/src-tauri && cargo fmt --check)

printf '== clippy ==\n'
(cd desktop/src-tauri && cargo clippy --all-targets -- -D warnings)

printf '== prettier ==\n'
bunx prettier --check .

printf '== markdownlint ==\n'
bunx markdownlint-cli2

printf '== xo ==\n'
bunx xo
