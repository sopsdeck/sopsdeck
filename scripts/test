#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export PATH="$(go env GOPATH)/bin:${PATH}"

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing %s — %s\n' "$1" "$2" >&2
    exit 1
  fi
}

need go "https://go.dev/dl/"
need bun "https://bun.sh"

printf '== go test ==\n'
go test ./cmd/... ./internal/...

printf '== bun test ==\n'
bun test bin/sopsdeck.test.mjs desktop/src scripts/changelog-notes.test.js scripts/release-artifacts.test.js
