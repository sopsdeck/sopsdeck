{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start app with Managed File",
      "type": "process",
      "command": "sopsdeck",
      "args": ["run", "-f", ".env", "--", "npm", "run", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
